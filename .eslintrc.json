{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "off",
    "no-useless-escape": "off"
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "build/",
    "ktheme-pr/",
    "docs/vendor/",
    "docs/support.js"
  ]
}
