{
  "$schema": "https://kaleaon.github.io/linkpoint-design/layout-schema.v1.json",
  "version": "1.0.0",
  "layouts": [
    {
      "id": "metro",
      "name": "Metro",
      "navModel": "TILES",
      "cornerProfile": "SHARP",
      "densityProfile": "COMFORTABLE",
      "motionProfile": "STANDARD",
      "font": "\"Open Sans\", \"Segoe UI\", sans-serif",
      "displayFont": "\"Open Sans\", \"Segoe UI\", sans-serif",
      "cardLook": "flat",
      "headLook": "pivot",
      "segLook": "pivot",
      "description": "High-contrast Windows Phone Metro layout with flat tiles, zero corner radii, and lowercase pivot headers."
    },
    {
      "id": "lcars",
      "name": "LCARS",
      "navModel": "SWEEP",
      "cornerProfile": "PILLED",
      "densityProfile": "COMPACT",
      "motionProfile": "STANDARD",
      "font": "\"Antonio\", \"Jost\", sans-serif",
      "displayFont": "\"Antonio\", sans-serif",
      "cardLook": "cap",
      "headLook": "sweep",
      "segLook": "fill",
      "description": "Authentic Star Trek LCARS console layout with swept elbow rail frames and rounded pill caps."
    },
    {
      "id": "frutiger_aero",
      "name": "Frutiger Aero",
      "navModel": "TABS",
      "cornerProfile": "ROUNDED",
      "densityProfile": "COMFORTABLE",
      "motionProfile": "STANDARD",
      "font": "\"Nunito Sans\", sans-serif",
      "displayFont": "\"Nunito Sans\", sans-serif",
      "cardLook": "soft",
      "headLook": "stack",
      "segLook": "fill",
      "description": "Glossy Frutiger Aero layout with 12-18px curved corners, comfortable padding, and soft translucent panels."
    },
    {
      "id": "art_deco",
      "name": "Art Deco",
      "navModel": "RAIL",
      "cornerProfile": "SHARP",
      "densityProfile": "COMPACT",
      "motionProfile": "STANDARD",
      "font": "\"Jost\", system-ui, sans-serif",
      "displayFont": "\"Jost\", sans-serif",
      "cardLook": "rule",
      "headLook": "rule",
      "segLook": "text",
      "description": "Architectural Art Deco layout with hairline rules, sharp geometric angles, and wide letter-spacing."
    },
    {
      "id": "terminal",
      "name": "Terminal",
      "navModel": "TABS",
      "cornerProfile": "SHARP",
      "densityProfile": "COMPACT",
      "motionProfile": "STANDARD",
      "font": "\"JetBrains Mono\", \"IBM Plex Mono\", monospace",
      "displayFont": "\"JetBrains Mono\", monospace",
      "cardLook": "box",
      "headLook": "stack",
      "segLook": "fill",
      "description": "Dense command terminal grid with monospaced typography, tight line heights, and prompt indicators."
    },
    {
      "id": "modern_glass",
      "name": "Modern Glass",
      "navModel": "TABS",
      "cornerProfile": "ROUNDED",
      "densityProfile": "STANDARD",
      "motionProfile": "EXPRESSIVE",
      "font": "\"Nunito Sans\", sans-serif",
      "displayFont": "\"Nunito Sans\", sans-serif",
      "cardLook": "soft",
      "headLook": "stack",
      "segLook": "fill",
      "description": "Modern frosted glass layout with deep curvature, subtle glowing borders, and fluid animations."
    },
    {
      "id": "material3",
      "name": "Material3",
      "navModel": "TABS",
      "cornerProfile": "ROUNDED",
      "densityProfile": "STANDARD",
      "motionProfile": "STANDARD",
      "font": "system-ui, -apple-system, sans-serif",
      "displayFont": "system-ui, sans-serif",
      "cardLook": "quiet",
      "headLook": "stack",
      "segLook": "fill",
      "description": "Material Design 3 layout with rounded pill containers, expressive tonal elevation, and dynamic color integration."
    },
    {
      "id": "cyberpunk",
      "name": "Cyberpunk",
      "navModel": "RAIL",
      "cornerProfile": "SHARP",
      "densityProfile": "COMPACT",
      "motionProfile": "EXPRESSIVE",
      "font": "\"JetBrains Mono\", monospace",
      "displayFont": "\"JetBrains Mono\", monospace",
      "cardLook": "box",
      "headLook": "sweep",
      "segLook": "fill",
      "description": "High-tech dystopian cyberpunk layout with wireframe borders, chamfered cuts, and HUD telemetry rails."
    }
  ]
}
